SubDir HAIKU_TOP src system boot platform sfi ;

SubDirHdrs $(HAIKU_TOP) headers private kernel boot platform sfi ;

UsePrivateHeaders [ FDirName kernel disk_device_manager ] ;
UsePrivateHeaders [ FDirName graphics common ] ;
UsePrivateHeaders [ FDirName storage ] ;

{
	local defines = _BOOT_PLATFORM_SFI ;

	defines = [ FDefines $(defines) ] ;
	SubDirCcFlags $(defines) ;
	SubDirC++Flags $(defines) -fno-rtti ;
	SubDirAsFlags -I $(SUBDIR) ;
}

local platform ;
for platform in [ MultiBootSubDirSetup sfi ] {
	on $(platform) {
		SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src add-ons accelerants common ] ;

		BootMergeObject boot_platform_sfi.o :
			shell.S
			start.cpp
			debug.cpp
			console.cpp
			devices.cpp
			graphics.cpp
			fixed_font.S
			keyboard.cpp
			menu.cpp
			mmu.cpp
			multiboot.cpp
			cpu.cpp
			acpi.cpp
			smp.cpp
			smp_trampoline.S
			support.S
			video.cpp
			interrupts.cpp
			interrupts_asm.S
			long.cpp
			long_asm.S
			:
			: boot_platform_generic_sfi.a
		;
	}
}
